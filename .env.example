# Environment
NODE_ENV=development

# Server
PORT=3000
UI_PORT=8080
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://opencommerce:opencommerce_dev_password@localhost:5432/opencommerce

# Redis
REDIS_URL=redis://localhost:6379

# Ollama (AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# DoorDash
DOORDASH_DEVELOPER_ID=your_developer_id
DOORDASH_KEY_ID=your_key_id
DOORDASH_SIGNING_SECRET=your_signing_secret
DOORDASH_WEBHOOK_SECRET=your_webhook_secret

# Uber Eats
UBER_CLIENT_ID=your_client_id
UBER_CLIENT_SECRET=your_client_secret
UBER_STORE_ID=your_store_id

# Website Integration
WEBSITE_API_KEY=your_website_api_key
WEBSITE_WEBHOOK_SECRET=your_webhook_secret

# Elistar
ELISTAR_IMPORT_SECRET=your_secret_token
ELISTAR_EXPORT_ENDPOINT=https://elistar.example.com/api/transactions

# Store Configuration
STORE_ID=STORE_001
STORE_NAME=Liquor River Ocala
STORE_ADDRESS=123 Main St, Ocala, FL 34470
STORE_TAX_RATE=0.07
STORE_TIMEZONE=America/New_York

# Channel Pricing Markup (decimal, e.g., 0.30 = 30%)
MARKUP_DOORDASH=0.30
MARKUP_UBER_EATS=0.25
MARKUP_WEBSITE=0.10
MARKUP_IN_STORE=0.00

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Logging
LOG_LEVEL=info
LOG_FILE=logs/opencommerce.log

# Hardware (USB device paths - adjust for your system)
PRINTER_VENDOR_ID=0x04b8
PRINTER_PRODUCT_ID=0x0e15
SCANNER_VENDOR_ID=0x05e0
SCANNER_PRODUCT_ID=0x1900

# Feature Flags
ENABLE_DOORDASH=true
ENABLE_UBER_EATS=true
ENABLE_WEBSITE=true
ENABLE_OLLAMA_SEARCH=true
ENABLE_AGE_VERIFICATION=true
