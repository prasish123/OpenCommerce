# Test Environment Configuration
NODE_ENV=test

# Database
DATABASE_URL=postgresql://test:test@localhost:5432/opencommerce_test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opencommerce_test
DB_USER=test
DB_PASSWORD=test

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000

# Store Configuration
STORE_ID=STORE-TEST-001
STORE_NAME=Test Store
STORE_ADDRESS=123 Test St, Test City, TS 12345

# JWT
JWT_SECRET=test-secret-key-for-testing-only-do-not-use-in-production
JWT_EXPIRY=5m
SESSION_SECRET=test-session-secret

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=whsec_test1234567890
STRIPE_TERMINAL_LOCATION_ID=tml_test123

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_TO_CONSOLE=true

# Encryption (for age verification photos)
PHOTO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_AGE_VERIFICATION=true
ENABLE_LOYALTY=true
ENABLE_THIRD_PARTY_CHANNELS=false

# Test-specific
SIMULATE_PRINTER=true
SIMULATE_STRIPE_TERMINAL=true
TEST_DATA_CLEANUP=true
